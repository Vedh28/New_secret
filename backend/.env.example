# SECRET backend environment template.
# Copy to .env and fill in real values. NEVER commit real secrets.

# --- PostgreSQL (async SQLAlchemy) ---
DATABASE_URL=postgresql+asyncpg://secret:secret@localhost:5432/secret

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secret

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
SECRET_ENV=dev
CORS_ORIGINS=["http://localhost:5173"]

# --- AI extraction provider ---
# Paste your Gemini API key here. Keep this file local and never commit it.
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
